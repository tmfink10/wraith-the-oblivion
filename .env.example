# ─── Wraith Server Configuration ─────────────────────────────

# Port the server listens on (default: 3001)
PORT=3001

# JWT secret for authentication tokens
# IMPORTANT: Change this to a random string in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production

# SQLite database file path (default: ./data/wraith.db relative to CWD)
# DATABASE_PATH=./data/wraith.db

# CORS origin — set this only for development when client runs on a different port
# Leave unset in production (client is served from the same origin)
# CORS_ORIGIN=http://localhost:3000

# Path to the built client files (default: ./packages/client/dist)
# CLIENT_DIST_PATH=./packages/client/dist
